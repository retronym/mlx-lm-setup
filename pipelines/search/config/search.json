{
  "description": "Global settings for the search indexer: where data lives, which models, GitHub and Discourse politeness, and which local-model steps are on. Projects live in projects/*.json, universes in universes/*.json.",
  "data_dir": "data",
  "me": ["retronym", "Jason Zaugg"],
  "repos_dir": "repos",
  "embedder": {"model": "Qwen/Qwen3-Embedding-0.6B", "via": "gateway", "batch": 16},
  "reranker": {"model": "Qwen/Qwen3-Reranker-0.6B", "candidates": 30, "blend": [[3, 0.75], [10, 0.6], [1000, 0.4]]},
  "cache": {"enabled": true, "max_entries": 200000},
  "fusion": {"k": 60, "top_bonus": [0.05, 0.02, 0.02]},
  "chunking": {"max_chars": 2400, "min_chars": 20, "pack_chars": 1000},
  "discourse": {"delay_s": 1.0, "max_retries": 6, "user_agent": "scala-search-indexer (local research index; https://github.com/retronym)"},
  "github": {"min_remaining": 300, "page_delay_s": 0.2, "page_limit": 90, "default_since": "2000-01-01T00:00:00Z"},
  "neighbours": {"enabled": true, "neighbours": 5, "min_similarity": 0.8, "clusters": 80},
  "links": {"enabled": true, "max_refs_per_chunk": 200, "legacy_prefixes": {"SI": "scala/bug"}, "repo_aliases": {"lampepfl/dotty": "scala/scala3"}, "bare_fallbacks": {"scala/scala": ["scala/bug"]}},
  "refresh": {
    "at": "03:00",
    "tiers": {"high": {"max_priority": 3}, "normal": {"max_priority": 6}, "low": {"max_priority": 9}},
    "reconcile_every_days": 7,
    "budget_hours": null
  },
  "llm": {
    "noise_filter": {"enabled": false, "model": "jevstyle-2b"},
    "thread_summaries": {"enabled": false, "model": "qwen3-coder", "min_comments": 8, "max_per_run": 200},
    "digest": {"enabled": true, "model": "qwen3-coder"},
    "eval_questions": {"model": "qwen3-coder", "per_project": 40}
  }
}
